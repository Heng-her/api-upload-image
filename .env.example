# Copy this file to .env and fill in your real values.
# Get these from: https://console.cloudinary.com/app/settings/829483812561861
# NEVER commit the real .env file to version control.

CLOUDINARY_CLOUD_NAME=cloudinary
CLOUDINARY_API_KEY=cloud_api_key
CLOUDINARY_API_SECRET=cloud_api_secret

PORT=3000
API_KEY=your_secret_api_key

# Max upload size in bytes (default 100MB = 104857600)
MAX_UPLOAD_BYTES=104857600

# Rate limiting settings (uploads allowed per time window per IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_UPLOADS=100
